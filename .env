# Local-development credentials. NOT a real secret — the only thing
# this KEK protects is the test-PN material baked into the seed module
# (which is itself in plain hex in the source tree). Real environments
# override DODEX_KEK_HEX through their own secret-management system
# (k8s Secret, docker --env-file, etc.); dotenvy::dotenv() does not
# override variables already present in the process env, so a real
# deployment with the variable set will keep using it.

DODEX_KEK_HEX=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Test-database URL for `cargo test`. Points at the throwaway Postgres
# brought up by `docker compose -f docker-compose.test.yml up -d`.
TEST_DATABASE_URL=postgres://dodex:dodex@localhost:55432/dodex_test
