.DS_Store
.temp/
internal-docs/
target/
worktrees/
# Host-mounted service logs (docker-compose bind mounts ./logs/<service>).
logs/
.claude/roles/
.claude/commands.txt
.claude/skills/reviewer-core/
scripts/
config/indexer.stage.supabase.yaml
config/api.stage.supabase.yaml
# `.env.example` is committed as a template; the real `.env` and any
# environment-specific overrides stay local so secrets can never land in git.
.env
.env.local
.env.stage
.env.prod
plan.md

# Private-note / OB-market pools carry oracle/deployer/note secret keys —
# keep local, never commit. See PRIVATE_NOTE_POOLS.md for what each is.
sdk/ob_pool.json
sdk/pn_pool*.json
# e2e seed notes (real keys) — fetched from S3 in CI, never commit.
tests/fixtures/seed_notes*.json
# Local-dev API seed notes (real keys) — dropped at runtime, never commit.
config/seed_notes*.json

# CI e2e runtime dirs, created at the repo root by .woodpecker/e2e.yml. They hold
# material that must NEVER land in this PUBLIC repo: .acki-nacki/ is a transient
# acki-nacki clone whose config/ carries plaintext seckeys (block-manager signing
# keys, DEX test-note seckeys) + docker/.env; .ssh/ holds the CI SSH key;
# .inventory/ holds the private host inventory; .bin/ holds extracted binaries.
/.acki-nacki/
/.inventory/
/.ssh/
/.bin/
/acki_net_host

# Ansible deploy: per-environment inventories carry host addresses + encrypted
# vaults. Commit only the *.example dirs and templates. See deploy/ansible/README.md.
deploy/ansible/inventories/*/
!deploy/ansible/inventories/*.example/
