# Python bytecode caches (generated when running the dexdo skill client)
__pycache__/
*.pyc
# halo2 KZG SRS + proving-key cache (~500MB), generated at repo root by
# mint_pn_pool / mint_ob_pool when proving deposit vouchers. Regenerable, never commit.
params/
