  "description": "All OTLP metrics exported by the dodex indexer (service.name=dodex-indexer), via a Prometheus data source. Counters carry the OTel-default _total suffix; flip the 'counter_suffix' variable to empty if your collector sets add_metric_suffixes:false.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["dodex", "indexer", "inference"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(indexer_projection_backlog, job)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "job",
        "multi": true,
        "name": "job",
        "options": [],
        "query": {
          "query": "label_values(indexer_projection_backlog, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(indexer_projection_backlog{job=~\"$job\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(indexer_projection_backlog{job=~\"$job\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
