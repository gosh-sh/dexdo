    {
      "type": "timeseries",
      "title": "Decode failures rate",
      "description": "rate() of indexer_decode_errors (hard decode failures — ABI drift / malformed cell) and indexer_decode_ambiguous_collisions (a colliding event id with no dst route — should be flat zero; non-zero means a new colliding ABI was added without a decoder dst route, and those events are silently dropped). Both leave the row undecoded and skipped by projection.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "id": 18,
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" },
