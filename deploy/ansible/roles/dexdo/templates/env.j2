# OpenTelemetry/OTLP metrics endpoint for the indexer. When unset, no metrics
# are collected. Point it at your OTLP collector (gRPC), for example:
OTEL_EXPORTER_OTLP_ENDPOINT={{ dexdo_otel_endpoint }}
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL={{ dexdo_otel_metrics_protocol }}
OTEL_SERVICE_NAME={{ dexdo_otel_service_name }}
