# Rendered by Ansible (deploy/ansible/roles/dexdo). Do NOT edit on the host —
# it is overwritten on the next deploy. Change the template instead.
#
# Image-based: images are pulled from the registry (built by .woodpecker/build.yml),
# pinned to {{ dexdo_registry }}/dexdo-{api,indexer}:{{ dexdo_image_tag }}.
# Nothing is built on the host.
{% if dexdo_db_local %}
# dexdo_db_local=true: a bundled throwaway Postgres runs here — tuned like
# docker-compose.test.yml (ephemeral tmpfs storage, crash-safety off) for e2e.
{% else %}
# dexdo_db_local=false: no Postgres here — services connect to the external DB
# at dexdo_db_host:dexdo_db_port.
{% endif %}
services:
{% if dexdo_db_local %}
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: "{{ dexdo_db_user }}"
      POSTGRES_PASSWORD: "{{ dexdo_db_password }}"
      POSTGRES_DB: "{{ dexdo_db_name }}"
      # Throwaway test DB — skip fsync on initdb (see docker-compose.test.yml).
      POSTGRES_INITDB_ARGS: "--no-sync"
    command:
      - postgres
      - -c
      - fsync=off
      - -c
      - synchronous_commit=off
      - -c
      - full_page_writes=off
{% if dexdo_db_publish_port %}
    # Publish for an out-of-compose test runner. dexdo_db_bind_ip (empty -> all
    # interfaces) pins the bind interface.
    ports:
      - "{% if dexdo_db_bind_ip %}{{ dexdo_db_bind_ip }}:{% endif %}{{ dexdo_db_publish_port }}:5432"
{% endif %}
    # Ephemeral storage — DB resets on container restart (throwaway test DB).
    tmpfs:
      - /var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ dexdo_db_user }} -d {{ dexdo_db_name }}"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 5s

{% endif %}
  api:
    image: {{ dexdo_registry }}/dexdo-api:{{ dexdo_image_tag }}
{% if dexdo_host_network %}
    # Host network stack (e2e): the api shares the host's loopback so it reaches
    # a co-located acki-nacki network on 127.0.0.1 (nginx0 :80) and the bundled
    # postgres via its published 127.0.0.1:{{ dexdo_db_publish_port }} port —
    # used when there is no private host interface to bind the chain endpoint on.
    network_mode: host
{% endif %}
{% if dexdo_db_local %}
    depends_on:
      postgres:
        condition: service_healthy
{% endif %}
    environment:
      APP_CONFIG: /app/config/api.{{ dexdo_env }}.yaml
      RUST_LOG: "{{ dexdo_rust_log }}"
      LOG_DIR: /app/logs
{% if not dexdo_host_network %}
    ports:
      - "{{ dexdo_api_port }}:{{ dexdo_api_port }}"
{% endif %}
    volumes:
      - ./config:/app/config:ro
      - ./logs/api:/app/logs
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:{{ dexdo_api_port }}/readiness"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  indexer:
    image: {{ dexdo_registry }}/dexdo-indexer:{{ dexdo_image_tag }}
{% if dexdo_host_network %}
    # See api above — host loopback so the indexer reaches the co-located
    # acki-nacki chain on 127.0.0.1 and postgres on 127.0.0.1:{{ dexdo_db_publish_port }}.
    network_mode: host
{% endif %}
{% if dexdo_db_local %}
    depends_on:
      postgres:
        condition: service_healthy
{% endif %}
    env_file:
      - .env
    environment:
      APP_CONFIG: /app/config/indexer.{{ dexdo_env }}.yaml
      RUST_LOG: "{{ dexdo_rust_log }}"
      LOG_DIR: /app/logs
    volumes:
      - ./config:/app/config:ro
      - ./logs/indexer:/app/logs
    restart: unless-stopped
